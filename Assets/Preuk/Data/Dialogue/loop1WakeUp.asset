%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8453e01badfd74c409ba1b29f21aa1e8, type: 3}
  m_Name: loop1WakeUp
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScriptableObject
  lines:
  - spriteImage: {fileID: 752313563, guid: 300db373928b38f45a1826963cc9dcc3, type: 3}
    name: Kairos
    text: Ugh... What the hell?
  - spriteImage: {fileID: 1047115457, guid: 37d55987ad413b240ab05e7a56eec345, type: 3}
    name: Lucius
    text: You're finally awake! Are you hurt anywhere?
  - spriteImage: {fileID: 752313563, guid: 300db373928b38f45a1826963cc9dcc3, type: 3}
    name: Kairos
    text: (Why can't I see his face? Is this the price for this power? What will
      I lose next?)
  - spriteImage: {fileID: 1047115457, guid: 37d55987ad413b240ab05e7a56eec345, type: 3}
    name: Lucius
    text: That chest was a trap. It teleported us into this dungeon.
  - spriteImage: {fileID: 752313563, guid: 300db373928b38f45a1826963cc9dcc3, type: 3}
    name: Kairos
    text: Oh... yeah...
  - spriteImage: {fileID: 1047115457, guid: 37d55987ad413b240ab05e7a56eec345, type: 3}
    name: Lucius
    text: We'd better find a way out of here first.
  - spriteImage: {fileID: 752313563, guid: 300db373928b38f45a1826963cc9dcc3, type: 3}
    name: Kairos
    text: (This time I'll protect you no matter what, Lucius. I won't loop back again.)
  - spriteImage: {fileID: 752313563, guid: 300db373928b38f45a1826963cc9dcc3, type: 3}
    name: Kairos
    text: Let's try the other way this time.
