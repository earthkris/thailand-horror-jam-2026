--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8453e01badfd74c409ba1b29f21aa1e8, type: 3}
  m_Name: dungeonWakeUp
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScriptableObject
  lines:
  - spriteImage: {fileID: 752313563, guid: 300db373928b38f45a1826963cc9dcc3, type: 3}
    name: Kairos
    text: Ugh... Where are we..?
  - spriteImage: {fileID: 1047115457, guid: 37d55987ad413b240ab05e7a56eec345, type: 3}
    name: Lucius
    text: You're finally awake, are you hurt anywhere?
  - spriteImage: {fileID: 752313563, guid: 300db373928b38f45a1826963cc9dcc3, type: 3}
    name: Kairos
    text: I'm fine but... What is going on?
  - spriteImage: {fileID: 1047115457, guid: 37d55987ad413b240ab05e7a56eec345, type: 3}
    name: Lucius
    text: I think that chest was a trap. It teleported us into this dungeon.
  - spriteImage: {fileID: 752313563, guid: 300db373928b38f45a1826963cc9dcc3, type: 3}
    name: Kairos
    text: Are you kidding, how is this even possible?!
  - spriteImage: {fileID: 1047115457, guid: 37d55987ad413b240ab05e7a56eec345, type: 3}
    name: Lucius
    text: I don't know, but I think we better find a way out of here first. Let's
      go find the way out.
  - spriteImage: {fileID: 752313563, guid: 300db373928b38f45a1826963cc9dcc3, type: 3}
    name: Kairos
    text: Yeah, let's go.
