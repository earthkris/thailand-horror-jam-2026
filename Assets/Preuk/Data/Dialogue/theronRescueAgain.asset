  m_Script: {fileID: 11500000, guid: 8453e01badfd74c409ba1b29f21aa1e8, type: 3}
  m_Name: theronRescueAgain
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScriptableObject
  lines:
  - spriteImage: {fileID: 1839732707, guid: 400e3b291fb945d9b701b6a3d2cf10ac, type: 3}
    name: Theron
    text: ...You. I dreamt this. You cut me down, then there were eyes in the dark,
      then you cut me down again.
  - spriteImage: {fileID: 752313563, guid: 300db373928b38f45a1826963cc9dcc3, type: 3}
    name: Kairos
    text: It isn't a dream. Come on. This time we keep everyone.
  - spriteImage: {fileID: 1839732707, guid: 400e3b291fb945d9b701b6a3d2cf10ac, type: 3}
    name: Theron
    text: Then I'm not wasting a single arrow.
