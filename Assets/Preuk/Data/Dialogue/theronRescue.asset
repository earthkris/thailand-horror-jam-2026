  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8453e01badfd74c409ba1b29f21aa1e8, type: 3}
  m_Name: theronRescue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScriptableObject
  lines:
  - spriteImage: {fileID: 1839732707, guid: 400e3b291fb945d9b701b6a3d2cf10ac, type: 3}
    name: Theron
    text: Get it off, get it OFF me! ...Oh. You're not spiders.
  - spriteImage: {fileID: 752313563, guid: 300db373928b38f45a1826963cc9dcc3, type: 3}
    name: Kairos
    text: Easy. We're getting out of here. Can you stand?
  - spriteImage: {fileID: 1839732707, guid: 400e3b291fb945d9b701b6a3d2cf10ac, type: 3}
    name: Theron
    text: Theron. I hunt the edge of the forest. I followed the screaming down here...
      three nights ago, maybe.
  - spriteImage: {fileID: 1839732707, guid: 400e3b291fb945d9b701b6a3d2cf10ac, type: 3}
    name: Theron
    text: They left me my bow and my knife. Point me at the next thing with too many
      legs.
