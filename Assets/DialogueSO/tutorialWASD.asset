  lines:
  - spriteImage: {fileID: 1047115457, guid: 37d55987ad413b240ab05e7a56eec345, type: 3}
    name: Lucius
    text: Kairos, look out! A giant spider!
  - spriteImage: {fileID: 752313563, guid: 300db373928b38f45a1826963cc9dcc3, type: 3}
    name: Kairos
    text: Ha! That's one big bug. Let's take it down!
  - spriteImage: {fileID: 1047115457, guid: 37d55987ad413b240ab05e7a56eec345, type: 3}
    name: Lucius
    text: Walk over to it with <b>W A S D</b>, or click the ground. I'll be right
      behind you!
